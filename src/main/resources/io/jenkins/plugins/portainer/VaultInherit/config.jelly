<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:description>${descriptor.vaultInheritSummary}</f:description>
  <f:entry title="${%Vault KV mount}" field="vaultMount">
    <f:textbox default="secret"/>
  </f:entry>
  <f:entry title="${%Vault path}" field="vaultPath">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Vault namespace Enterprise}" field="vaultNamespace">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Vault secret version}" field="vaultVersion">
    <f:textbox/>
  </f:entry>
</j:jelly>
