<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials" xmlns:p="/lib/portainer">
  <div class="portainer-api-form">
    <p:connection/>
    <f:entry title="${%Endpoint ID}" field="endpointId">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Release name}" field="releaseName">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Chart}" field="chart">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Chart repository URL}" field="repo">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Namespace}" field="namespace">
      <f:textbox default="default"/>
    </f:entry>
    <f:entry title="${%Chart version}" field="version">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Values source}" help="${descriptor.getHelpFile('valuesSource')}"/>
    <j:set var="help" value="${null}"/>
    <f:radioBlock name="valuesSource" value="none" title="${%No source}"
                  checked="${instance == null || instance.valuesSource == 'none'}">
      <f:entry>
        <f:description>${%Use chart defaults.}</f:description>
      </f:entry>
    </f:radioBlock>
    <f:radioBlock name="valuesSource" value="repository" title="${%Repository}"
                  checked="${instance != null &amp;&amp; instance.valuesSource == 'repository'}">
      <f:entry title="${%Repository URL}" field="valuesRepositoryUrl">
        <f:textbox/>
      </f:entry>
      <f:entry title="${%Values file path}" field="valuesFilePath">
        <f:textbox default="values.yaml"/>
      </f:entry>
      <f:entry title="${%Git credentials}" field="valuesGitCredentialsId">
        <c:select/>
      </f:entry>
      <f:entry title="${%Repository reference}" field="valuesRepositoryReferenceName">
        <f:textbox default="refs/heads/main"/>
      </f:entry>
    </f:radioBlock>
    <f:radioBlock name="valuesSource" value="yaml" title="${%Manual YAML}"
                  checked="${instance != null &amp;&amp; instance.valuesSource == 'yaml'}">
      <f:entry title="${%Values YAML}" field="values">
        <f:textarea/>
      </f:entry>
    </f:radioBlock>
    <f:advanced title="${%Advanced}">
      <f:entry title="${%Atomic}" field="atomic">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Force reinstall}" field="forceReinstall">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Ensure namespace}" field="ensureNamespace">
        <f:checkbox checked="${instance == null || instance.ensureNamespace}"/>
      </f:entry>
      <f:entry title="${%Validate only}" field="validateOnly">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Verbose logging}" field="verboseLogging">
        <f:checkbox/>
      </f:entry>
    </f:advanced>
  </div>
</j:jelly>
