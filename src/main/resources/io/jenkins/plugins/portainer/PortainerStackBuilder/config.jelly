<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials" xmlns:p="/lib/portainer">
  <div class="portainer-api-form">
    <p:connection/>
    <f:entry title="${%Endpoint ID}" field="endpointId">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Stack type}" field="stackType">
      <f:select/>
    </f:entry>
    <f:entry title="${%Stack name}" field="stackName">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Stack source}" help="${descriptor.getHelpFile('stackSource')}"/>
    <j:set var="help" value="${null}"/>
    <f:radioBlock inline="true" name="stackSource" value="repository" title="${%Repository}"
                  checked="${instance == null || instance.stackSource != 'yaml'}">
      <f:entry title="${%Repository URL}" field="repositoryUrl">
        <f:textbox/>
      </f:entry>
      <f:entry title="${%Compose file path}" field="composeFilePath">
        <f:textbox default="docker-compose.yml"/>
      </f:entry>
      <f:entry title="${%Git credentials}" field="gitCredentialsId">
        <c:select/>
      </f:entry>
      <f:entry title="${%Repository reference}" field="repositoryReferenceName">
        <f:textbox default="refs/heads/main"/>
      </f:entry>
    </f:radioBlock>
    <f:radioBlock inline="true" name="stackSource" value="yaml" title="${%Manual YAML}"
                  checked="${instance != null &amp;&amp; instance.stackSource == 'yaml'}">
      <f:entry title="${%Stack / compose YAML}" field="stackFileContent">
        <f:textarea/>
      </f:entry>
    </f:radioBlock>
    <f:advanced title="${%Advanced}">
      <f:entry title="${%Environment variables}" field="env">
        <f:textarea/>
      </f:entry>
      <f:dropdownDescriptorSelector field="vault" title="${%Vault}"
                                    descriptors="${descriptor.vaultDescriptors}"/>
      <div style="border-top:var(--jenkins-border);" class="jenkins-!-margin-bottom-3"/>
      <f:entry title="${%Prune services}" field="prune">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Repull images and redeploy}" field="repullImageAndRedeploy">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Merge with existing stack env}" field="mergeEnvWithExisting">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Validate only}" field="validateOnly">
        <f:checkbox/>
      </f:entry>
      <f:entry title="${%Verbose logging}" field="verboseLogging">
        <f:checkbox/>
      </f:entry>
    </f:advanced>
  </div>
</j:jelly>
